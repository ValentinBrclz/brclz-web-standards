{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.preview)",
      "Read(./.env.test)",
      "Read(./.env.*.local)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.local)",
      "Read(./.dev.vars.development)",
      "Read(./.dev.vars.production)",
      "Read(./.dev.vars.staging)",
      "Read(./.dev.vars.preview)",
      "Read(./.dev.vars.test)"
    ],
    "ask": [
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler deploy *)",
      "Bash(wrangler versions deploy *)",
      "Bash(npx wrangler versions deploy *)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler secret *)",
      "Bash(npm run deploy *)",
      "Bash(npm publish *)"
    ]
  }
}
