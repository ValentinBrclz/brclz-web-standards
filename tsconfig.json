{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./typescript/tsconfig.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": ["src/**/*.mjs", "bin/**/*.mjs", "examples/**/*.mjs", "scripts/**/*.mjs"]
}
